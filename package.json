{
  "name": "ava-persian-transcriber",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "electron .",
    "test": "node --test tests/engine.test.cjs",
    "test:desktop": "node tests/desktop.cjs",
    "pack": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.89.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "description": "Private offline Persian audio and video transcription",
  "author": "aliabedi1",
  "main": "electron/main.cjs",
  "build": {
    "appId": "local.ava.transcriber",
    "productName": "Ava",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "runtime/whisper/Release",
        "to": "runtime/whisper/Release",
        "filter": [
          "whisper-cli.exe",
          "*.dll"
        ]
      },
      {
        "from": "runtime/ffmpeg",
        "to": "runtime/ffmpeg"
      },
      {
        "from": "models",
        "to": "models",
        "filter": [
          "*.bin"
        ]
      },
      {
        "from": "third-party",
        "to": "third-party"
      },
      {
        "from": "runtime/vulkan",
        "to": "runtime/vulkan",
        "filter": [
          "whisper-cli.exe",
          "*.dll"
        ]
      }
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "electronDist": "./node_modules/electron/dist",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ava",
      "runAfterFinish": true,
      "artifactName": "Ava-Setup-${version}-${arch}.${ext}"
    }
  }
}
